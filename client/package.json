{
  "name": "porfirevich-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend for Porfirevich project",
  "main": "src/main.ts",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/browser/*.test.cjs",
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "prod": "npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nextgis/utils": "^4.0.0",
    "buefy": "^3.1.0",
    "debounce": "^3.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
