{
  "name": "porfirevich-web",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "lint": "npm --prefix client run lint && npm --prefix server run lint",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "release": "release-it"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "release-it": "^21.0.2"
  }
}
