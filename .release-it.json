{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "commit": true,
    "commitMessage": "chore(release): version ${version}",
    "tag": true,
    "tagName": "v${version}",
    "push": false,
    "requireCleanWorkingDir": true,
    "requireUpstream": false
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "gitlab": {
    "release": false
  },
  "hooks": {
    "before:init": [
      "npm run lint",
      "npm run build"
    ],
    "after:bump": [
      "npm --prefix client version ${version} --no-git-tag-version",
      "npm --prefix server version ${version} --no-git-tag-version"
    ]
  }
}
