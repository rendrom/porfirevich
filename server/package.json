{
  "name": "porfirevich-server",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/prod.js",
    "dev": "cross-env NODE_ENV=development tsx watch src/prod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -n StoryRefactoring",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "setsuperuser": "tsx ./scripts/setsuperuser.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.6",
    "class-validator": "^0.15.1",
    "convict": "^6.2.5",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^4.1.1",
    "inversify": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-anonymous": "^1.0.1",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.9.0",
    "prompts": "^2.3.2",
    "puppeteer": "^25.3.0",
    "reflect-metadata": "^0.1.13",
    "typeorm": "0.2.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/body-parser": "^1.19.0",
    "@types/convict": "^6.1.6",
    "@types/cors": "^2.8.6",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/events": "^3.0.0",
    "@types/express": "^4.17.2",
    "@types/helmet": "0.0.48",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-anonymous": "^1.0.3",
    "@types/passport-google-oauth": "^1.0.41",
    "@types/passport-jwt": "^3.0.3",
    "@types/prompts": "^2.4.9",
    "cross-env": "^7.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
