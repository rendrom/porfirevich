{
  "name": "porfirevich-server",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/prod.js",
    "dev": "cross-env NODE_ENV=development tsx watch src/prod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/server/tests/*.test.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/server/src/data-source.js",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/server/src/data-source.js",
    "typeorm": "typeorm",
    "setsuperuser": "npm run build && node dist/server/scripts/setsuperuser.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "convict": "^6.2.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-anonymous": "^1.0.1",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prompts": "^2.3.2",
    "puppeteer": "^25.10.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/convict": "^6.1.6",
    "@types/cors": "^2.8.6",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-anonymous": "^1.0.3",
    "@types/passport-google-oauth": "^1.0.41",
    "@types/passport-jwt": "^4.0.1",
    "@types/prompts": "^2.4.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
